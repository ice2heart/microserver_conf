# ============================================================
# torrentbox secrets template
# Copy to .env and fill in real values. .env is gitignored.
# ============================================================

TZ=UTC

# --- samba ---
SAMBA_USER=ice
SAMBA_PASSWORD=changeme

# --- sftpgo (backup server; admin UI at https://minioadmin.microserver) ---
SFTPGO_ADMIN_USER=admin
SFTPGO_ADMIN_PASSWORD=changeme

# --- twingate connector (generate in the Twingate admin console) ---
TWINGATE_NETWORK=
TWINGATE_ACCESS_TOKEN=
TWINGATE_REFRESH_TOKEN=

# --- protonvpn openvpn credentials (account.protonvpn.com -> OpenVPN/IKEv2 username)
# append +pmp to the username to enable port forwarding ---
VPN_USER=
VPN_PASSWORD=
VPN_SERVER_COUNTRIES=Romania

# --- paperless-ngx (generate keys with: openssl rand -hex 32) ---
PAPERLESS_SECRET_KEY=
PAPERLESS_DB_PASSWORD=
PAPERLESS_ADMIN_USER=
PAPERLESS_ADMIN_PASSWORD=

# --- homepage dashboard widget credentials (optional, widgets show errors until set) ---
# qBittorrent WebUI login (same as https://flood.microserver)
HOMEPAGE_VAR_QBT_USERNAME=
HOMEPAGE_VAR_QBT_PASSWORD=
# Jellyfin API key: Dashboard -> Advanced -> API Keys
HOMEPAGE_VAR_JELLYFIN_KEY=
# gluetun control server API key (openssl rand -base64 24) — must match
# the apikey in config/gluetun/auth.toml (copy from auth.toml.example)
HOMEPAGE_VAR_GLUETUN_KEY=
# Lidarr API key: Settings -> General -> Security
HOMEPAGE_VAR_LIDARR_KEY=
# Sonarr API key: Settings -> General -> Security
HOMEPAGE_VAR_SONARR_KEY=
# Radarr API key: Settings -> General -> Security
HOMEPAGE_VAR_RADARR_KEY=
# Prowlarr API key: Settings -> General -> Security
HOMEPAGE_VAR_PROWLARR_KEY=
# Navidrome: create a dedicated user for the widget (Settings -> Users), or reuse admin
HOMEPAGE_VAR_NAVIDROME_USERNAME=
# token = md5(password + salt), salt = any random string
HOMEPAGE_VAR_NAVIDROME_TOKEN=
HOMEPAGE_VAR_NAVIDROME_SALT=
